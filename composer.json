{
  "name": "redeemly-likecard/luckycode-package",
  "description": "Seamlessly integrate Redeemly LuckyCode rewards into any PHP application",
  "type": "library",
  "license": "MIT",
  "version": "2.2.3",
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "codeigniter4/framework": "^4.7"
  },
  "autoload": {
    "psr-4": {
      "LuckyCode\\IntegrationHelper\\": "src/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "LuckyCode\\IntegrationHelper\\CodeIgniter\\Installer::postInstall"
    ],
    "post-update-cmd": [
      "LuckyCode\\IntegrationHelper\\CodeIgniter\\Installer::postInstall"
    ],
    "post-autoload-dump": [
      "php scripts/post-autoload-dump.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "LuckyCode\\IntegrationHelper\\IntegrationHelperServiceProvider"
      ]
    }
  },
  "repositories": {
    "luckycode": {
      "type": "path",
      "url": "..\\"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
