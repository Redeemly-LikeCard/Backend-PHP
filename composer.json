{
  "name": "redeemly-likecard/luckycode-package",
  "description": "Seamlessly integrate Redeemly LuckyCode rewards into any PHP application",
  "type": "library",
  "license": "MIT",
  "version": "2.3.1",
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "codeigniter4/framework": "^4.7"
  },
  "autoload": {
    "psr-4": {
      "LuckyCode\\IntegrationHelper\\": "src/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"if (class_exists('LuckyCode\\\\IntegrationHelper\\\\CodeIgniter\\\\Installer')) { LuckyCode\\\\IntegrationHelper\\\\CodeIgniter\\\\Installer::postInstall(); }\""
    ],
    "post-update-cmd": [
      "@php -r \"if (class_exists('LuckyCode\\\\IntegrationHelper\\\\CodeIgniter\\\\Installer')) { LuckyCode\\\\IntegrationHelper\\\\CodeIgniter\\\\Installer::postInstall(); }\""
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "LuckyCode\\IntegrationHelper\\IntegrationHelperServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}